<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101418">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_title"
            android:textSize="32sp"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="48dp" />

        <!-- Кнопка «Продолжить» — видима только если есть прогресс -->
        <Button
            android:id="@+id/btn_continue"
            android:layout_width="320dp"
            android:layout_height="64dp"
            android:textSize="20sp"
            android:background="@drawable/button_focus_selector"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Продолжить игру с последней главы" />

        <!-- Кнопка «Начать» — либо «Начать игру» (новичок), либо «Начать заново» -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="320dp"
            android:layout_height="64dp"
            android:textSize="20sp"
            android:background="@drawable/button_focus_selector"
            android:focusable="true"
            android:clickable="true"
            android:contentDescription="Начать игру с начала, с первой главы" />
    </LinearLayout>
</FrameLayout>
